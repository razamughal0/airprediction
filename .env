# ─────────────────────────────────────────────────────────────
# Uplift — environment template
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or real credentials.
# Windows PowerShell: Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (local PostgreSQL, Supabase, Neon, RDS…)
# Local Windows example:
PGUSER=neondb_owner
PGPASSWORD=npg_sMt5YqxJCX6I
DATABASE_URL=postgresql://neondb_owner:npg_sMt5YqxJCX6I@ep-nameless-sound-b5a54z56-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Supabase example (use the pooled "Session" or "Transaction" connection string):
# DATABASE_URL=postgresql://postgres.<project-ref>:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS. Managed providers usually require it; use DATABASE_SSL=true with the
# pooled Supabase connection string. Local PostgreSQL usually leaves it false.
DATABASE_SSL=false
# Set to "false" only for a self-signed development certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Automatically apply idempotent migrations and seed an empty database on the
# first request. Set both to "false" in managed production if you prefer to run
# `npm run db:migrate` / `npm run db:seed` yourself before deployment.
DB_AUTO_SETUP=true
DB_AUTO_SEED=true

# Signs the demo role-selection cookie. Use a long random string, e.g. generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this value in public or share it. Required in production.
SESSION_SECRET=qwertyuddjn

# ── AI assistant (optional) ───────────────────────────────────
# The assistant works without a key using a local, data-grounded guidance mode.
# With a key it calls any OpenAI-compatible chat-completions provider.
# OpenAI:
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# OpenRouter:      AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=openai/gpt-4o-mini
# Groq:            AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.3-70b-versatile
# Local Ollama:    AI_BASE_URL=http://127.0.0.1:11434/v1       AI_MODEL=llama3.1
# Local Ollama needs no real key; set AI_API_KEY=ollama
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=25000

# Optional: port for `npm run start` (defaults to 3000)
# PORT=3000
